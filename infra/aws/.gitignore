# Provider binaries and local state — never committed.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tf.plan

# Real variable values. Secrets belong in Secrets Manager, not here; anything
# put in a .tfvars ends up in state in plaintext.
*.tfvars
!*.tfvars.example

# .terraform.lock.hcl IS committed on purpose — it pins provider versions so a
# later apply cannot silently pick up a different AWS provider.
